{
  "name": "civil-exam-drill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "npm run build && wrangler pages dev dist --d1 DB=replace-after-wrangler-d1-create --local",
    "content:validate": "node scripts/content/validate.mjs",
    "content:build": "node scripts/content/build.mjs",
    "prebuild": "npm run content:validate && npm run content:build",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p functions/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@noble/hashes": "^2.0.1",
    "@shared/core": "file:../shared-core",
    "@types/turndown": "^5.0.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.9.6",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "marked": "^16.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sanitize-html": "^2.17.7",
    "turndown": "^7.2.4",
    "uuid": "^14.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "wrangler": "^4.32.0"
  }
}
